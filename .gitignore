# Ignore data folder, except probability-processing scripts
/data/*
!/data/ps/
/data/ps/*
!/data/ps/esm/
/data/ps/esm/*
!/data/ps/esm/process_ps.py
!/data/ps/msa/
/data/ps/msa/*
!/data/ps/msa/process_ps.py

# Common ignores
.DS_Store
Thumbs.db
node_modules/
__pycache__/
*.pyc
*.pyo
*.pyd
.env
.vscode/
.idea/
*.log
coverage/
dist/
build/

# Ignore CSVs, pdfs, and other large files
*.csv
*.pdf
*.png
*.npy
*.txt
