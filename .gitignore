# Ignore data folder, except probability-processing scripts and datasets
/data/*
!/data/ps/
/data/ps/*
!/data/ps/esm/
/data/ps/esm/*
!/data/ps/esm/process_ps.py
!/data/ps/msa/
/data/ps/msa/*
!/data/ps/msa/process_ps.py
!/data/fasta/
!/data/processed_msa/
/data/processed_msa/*
!/data/processed_msa/process_msa.py
!/data/processed_data/
/data/processed_data/*
!/data/processed_data/process_data.py

# Common ignores
.DS_Store
Thumbs.db
node_modules/
__pycache__/
*.pyc
*.pyo
*.pyd
.env
.vscode/
.idea/
*.log
coverage/
dist/
build/

# Ignore files
*.png
*.npy
*.txt
*dev*