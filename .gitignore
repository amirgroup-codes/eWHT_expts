# Ignore the data folder (on Figshare) except the processing scripts and FASTAs
/data/*
!/data/ps/
/data/ps/*
!/data/ps/esm_wildtype_marginal/
/data/ps/esm_wildtype_marginal/*
!/data/ps/esm_wildtype_marginal/process_ps.py
!/data/ps/esm_wildtype_marginal/esm_scoring.py
!/data/fasta/
!/data/processed_data/
/data/processed_data/*
!/data/processed_data/process_data.py

# Model weights and the local development copy
/models/

# ESM2 embeddings cache for the UMAP figure (large; regenerated by fitness_landscapes/plot_distribution.py)
/fitness_landscapes/distribution/embeddings/

# Common ignores
.DS_Store
Thumbs.db
node_modules/
__pycache__/
*.pyc
*.pyo
*.pyd
.env
.vscode/
.idea/
*.log
coverage/
dist/
build/

# Ignore files
*.png
*.npy
*.txt
*dev*